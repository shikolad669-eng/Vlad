# --- mod-bot config ---
# Скопируй в .env и заполни. .env в git НЕ попадает (см. корневой .gitignore).
# Токен утёк = сервер угнан. Никогда не коммить .env и не пересылай токен.

# Токен бота из Discord Developer Portal → Bot → Reset Token
DISCORD_TOKEN=

# ID сервера для мгновенной регистрации слэш-команд (dev).
# Пусто = глобальная регистрация (может обновляться до часа).
GUILD_ID=

# ID текстового канала для лога модерации (embed по каждому действию).
# Пусто = лог только в консоль.
MOD_LOG_CHANNEL_ID=
